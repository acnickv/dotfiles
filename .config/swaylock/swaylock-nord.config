# ┌──────────────────────────────────────────────┐
# │         swaylock — Nord Theme Config         │
# │   Place at: ~/.config/swaylock/config        │
# │                                              │
# │  Nord Palette used:                          │
# │  Polar Night: #2E3440 #3B4252 #434C5E #4C566A│
# │  Frost:       #8FBCBB #88C0D0 #81A1C1 #5E81AC│
# │  Aurora Red:  #BF616A  Aurora Green: #A3BE8C │
# └──────────────────────────────────────────────┘

# Background image (update path to match your actual wallpaper location)
image=~/.config/swaylock/nord-tech-lockscreen.png
scaling=fill

# Fallback solid background if image not found (Nord Polar Night 0)
color=2e3440

# Show failed auth attempts on the ring
show-failed-attempts

# Don't validate empty password submissions
ignore-empty-password

# Show the indicator even when idle
indicator-idle-visible

# Indicator geometry
indicator-radius=100
indicator-thickness=12

# ── Inside of the ring ─────────────────────────
# Idle/typing: translucent Polar Night 1
inside-color=3b425288
# After clearing input
inside-clear-color=3b425266
# Caps Lock active
inside-caps-lock-color=4c566a99
# While verifying password: Frost blue tint
inside-ver-color=5e81ac99
# Wrong password: Aurora red tint
inside-wrong-color=bf616a99

# ── Ring (outer) ───────────────────────────────
# Idle: Frost cyan
ring-color=88c0d0cc
# After clearing: dimmer frost
ring-clear-color=81a1c188
# Caps Lock: Polar Night 3
ring-caps-lock-color=4c566acc
# Verifying: Frost deeper blue
ring-ver-color=5e81accc
# Wrong: Aurora red
ring-wrong-color=bf616acc

# ── Separator line (between inside and ring) ───
line-uses-inside

# ── Key press highlights ───────────────────────
# Key press: Frost cyan pop
key-hl-color=88c0d0ff
# Backspace: Aurora red
bs-hl-color=bf616aff
# Caps Lock key press
caps-lock-key-hl-color=ebcb8bff
# Caps Lock backspace
caps-lock-bs-hl-color=d0877099

# ── Text ───────────────────────────────────────
# Normal text: Snow Storm 0
text-color=d8dee9ff
# Cleared: dimmer
text-clear-color=d8dee988
# Caps Lock: Aurora yellow
text-caps-lock-color=ebcb8bff
# Verifying: Frost blue
text-ver-color=88c0d0ff
# Wrong: Aurora red
text-wrong-color=bf616aff

# ── Layout text box (if show-keyboard-layout enabled) ─
layout-text-color=d8dee9cc
layout-bg-color=2e344099
layout-border-color=4c566a88

# ── Font ───────────────────────────────────────
# Swap for your preferred monospace font if desired
font=monospace
font-size=18
